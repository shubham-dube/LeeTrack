{
    "manifest_version": 3,
    "name": "LeetCode Tracker",
    "version": "1.0",
    "permissions": [
        "scripting",
        "activeTab",
        "storage"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "web_accessible_resources": [{
        "resources": ["https://cdn.socket.io/4.0.0/socket.io.min.js"],
        "matches": ["<all_urls>"]
    }],
    "host_permissions": [
        "*://leetcode.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://leetcode.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}