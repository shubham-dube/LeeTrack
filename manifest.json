{
    "manifest_version": 3,
    "name": "LeetCode Tracker",
    "version": "1.0",
    "permissions": [
        "scripting",
        "activeTab",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "*://leetcode.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "images/leet-logo.png",
        "48": "images/leet-logo.png",
        "128": "images/leet-logo.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://leetcode.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}